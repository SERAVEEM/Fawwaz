---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { r2, getPlaceholder } from '../utils/assets';
---

<BaseLayout
	title="About — FAWWAZ SIDIQ NURSETO (SERAVEEM) | Product Engineer"
	description="Learn about Fawwaz Sidiq Nurseto (SERAVEEM) — Product Engineer specializing in distributed system, and editorial creative engineering."
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Product Engineer & Creative Developer based in Indonesia. Building modular distributed systems and spatial editorial experiences."
			>
				<img
					width="1553"
					height="873"
					src={r2('/assets/at-work.webp')}
					alt="Fawwaz Sidiq Nurseto (SERAVEEM) — Product Engineer"
					loading="eager"
					decoding="async"
					fetchpriority="high"
					style={getPlaceholder('/assets/at-work.webp') ? `background-image: url("${getPlaceholder('/assets/at-work.webp')}"); background-size: cover;` : undefined}
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I am <strong>Fawwaz Sidiq Nurseto</strong> (also known online as <strong>SERAVEEM</strong>), a Product Engineer and Creative Developer focused on architectural clarity, resilient backend services, and high-performance frontend interfaces.
					</p>
					<p>
						Currently engineering solutions for <strong>Perspective std.</strong>, with experience directing technical workshops and people operations as HRD Manager at <strong>BNCC</strong> (Bina Nusantara Computer Club). My engineering practice bridges decoupled microservices architectures (NestJS, Prisma, MySQL) with editorial-grade motion and static site generation (Astro, Next.js, GSAP, Lenis).
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p><strong>Bina Nusantara University (BINUS)</strong> — Computer Science / Software Engineering.</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Core Competencies</h2>
				<div class="content">
					<p><strong>Architecture &amp; Backend:</strong> NestJS Microservices, Node.js, Express v5, Prisma ORM, MySQL, Redis, Stateless JWT Auth, REST &amp; SSE Protocols, Cloudflare R2.</p>
					<p><strong>Frontend &amp; Creative:</strong> TypeScript, Astro, Next.js SSG, React 19, Flutter Mobile, GSAP Motion, Lenis Smooth Scroll, Figma Design Systems.</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
