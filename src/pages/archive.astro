---

<BaseLayout
	title="Archive — FAWWAZ SIDIQ NURSETO (SERAVEEM) | Product Engineer"
	description="Curated engineering archive of microservices architectures, distributed systems, spatial design, and digital platforms by Fawwaz Sidiq Nurseto (SERAVEEM)."
	fullBleed={true}
	navTheme="dark"
	hideFooter={false}
>
	<main class="podium-archive-main" id="archiveContainer">
		<!-- Semantic Heading for Search Engines & Accessibility -->
		<h1 class="sr-only">Engineering Architecture &amp; Digital Production Archive — Fawwaz Sidiq Nurseto (SERAVEEM)</h1>

		<!-- Podium 1:1 Staggered Column Drift Grid -->
		<section class="podium-grid" id="podiumGrid" aria-label="Project Archive">
			{
				archiveProjects.map((project, index) => (
					<article
						class="project-card group"
						data-index={index}
						data-id={project.id}
					>
						<button
							type="button"
							class="card-button"
							data-project-index={index}
							aria-haspopup="dialog"
							aria-label={`Open details for ${project.title}`}
						>
							<!-- Media Viewport (Podium 1:1 348/259 Aspect Ratio + Hover Video) -->
							<div class="card-media-box">
								<img
									src={project.image}
									alt={project.title}
									class="card-media"
									style={[
										project.objectPosition ? `object-position: ${project.objectPosition};` : '',
										project.objectFit ? `object-fit: ${project.objectFit};` : ''
									].filter(Boolean).join(' ') || undefined}
									loading={index < 4 ? 'eager' : 'lazy'}
									decoding="async"
								/>
								{project.video && (
									<video
										src={project.video}
										preload="none"
										muted
										loop
										playsinline
										class="card-media card-video"
										aria-hidden="true"
									/>
								)}
								<div class="card-halo" aria-hidden="true" />
								{project.type === 'skill' && (
									<span class="card-skill-tag">[SKILL]</span>
								)}
							</div>

							<!-- Typography & Meta Information Row -->
							<div class="card-meta">
								<h2 class="card-title">{project.title}</h2>
								<div class="card-info">
									<span class="card-year">
										{project.badge && (
											<>
												<span class="card-badge-label">{project.badge}</span>
												<span class="card-meta-dot" aria-hidden="true">·</span>
											</>
										)}
										<span>{project.year}</span>
									</span>
									<span class="card-client">{project.client}</span>
								</div>
							</div>
						</button>
					</article>
				))
			}
		</section>
	</main>

	<!-- Compact Centered Detail Modal (Bounded Dialog, Not Fullscreen) -->
	<div
		class="archive-modal-backdrop"
		id="archiveModal"
		role="dialog"
		aria-modal="true"
		aria-hidden="true"
		tabindex="-1"
		data-lenis-prevent
	>
		<div class="archive-modal-card" id="archiveModalCard" data-lenis-prevent>
			<!-- Modal Top Bar -->
			<div class="modal-top-bar">
				<div class="modal-badge-wrap">
					<span class="modal-type-badge" id="modalTypeBadge">[PROJECT]</span>
					<span class="modal-index-badge" id="modalIndexBadge">/001</span>
				</div>
				<button
					type="button"
					class="modal-close-btn"
					id="modalCloseBtn"
					aria-label="Close project modal"
				>
					<span class="close-label">CLOSE</span>
					<span class="close-cross" aria-hidden="true">&times;</span>
				</button>
			</div>

			<!-- Modal Body (Internal Smooth Scroll) -->
			<div class="modal-body-scroll" data-lenis-prevent>
				<!-- High-Res Media Viewport -->
				<div class="modal-media-frame" id="modalMediaFrame">
					<img
						id="modalImg"
						src=""
						alt="Project Preview"
						class="modal-media-elem"
					/>
					<video
						id="modalVid"
						src=""
						playsinline
						loop
						muted
						autoplay
						class="modal-media-elem"
						style="display: none;"
					></video>
				</div>

				<!-- Content Section -->
				<div class="modal-content-area">
					<div class="modal-header-row">
						<div class="modal-title-group">
							<h3 class="modal-title" id="modalTitle">TITLE</h3>
							<p class="modal-client" id="modalClient">CLIENT / CONTEXT</p>
							<p class="modal-role" id="modalRole" style="display: none;">ROLE</p>
						</div>
						<span class="modal-year" id="modalYear">2026</span>
					</div>

					<!-- Tags / Highlights -->
					<div class="modal-section" id="modalTagsSection">
						<span class="modal-label">HIGHLIGHTS & STACK</span>
						<div class="modal-tags-grid" id="modalTagsList"></div>
					</div>

					<!-- Action Buttons (Only shown for projects with links) -->
					<div class="modal-actions-wrap" id="modalActionsWrap">
						<p class="modal-live-note" id="modalLiveNote" style="display: none;"></p>
						<div class="modal-actions-row" id="modalActionsRow">
							<a
								href="#"
								target="_blank"
								rel="noopener noreferrer"
								class="modal-action-btn btn-visit"
								id="modalVisitBtn"
							>
								<span>VISIT PROJECT</span>
								<span class="action-glyph">↗</span>
							</a>

							<a
								href="#"
								target="_blank"
								rel="noopener noreferrer"
								class="modal-action-btn btn-github"
								id="modalGithubBtn"
							>
								<svg class="action-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
								</svg>
								<span>GITHUB</span>
								<span class="action-glyph">↗</span>
							</a>
						</div>
					</div>

					<!-- Detailed Explanation -->
					<div class="modal-section modal-section-overview">
						<span class="modal-label">OVERVIEW</span>
						<p class="modal-description" id="modalDescription">Overview text...</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script id="projects-data" type="application/json" set:html={JSON.stringify(archiveProjects)} />
</BaseLayout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Client-side dataset matching server array
	const projectsData = JSON.parse(document.getElementById('projects-data')?.textContent || '[]');

	let mm: gsap.MatchMedia | null = null;

	function initPodiumScrollDrift() {
		const grid = document.getElementById('podiumGrid');
		if (!grid) return;

		if (mm) mm.revert();
		mm = gsap.matchMedia();

		const cards = gsap.utils.toArray<HTMLElement>('.project-card', grid);
		if (cards.length === 0) return;

		// 1. Desktop 4-Column Drift: Opposing kinetic wave matching Podium 1:1
		mm.add('(min-width: 1280px)', () => {
			const colProfiles = [
				{ initial: -98, target: -233 }, // Col 1: UP (-135px drift)
				{ initial: 78,  target: 186 },  // Col 2: DOWN (+108px drift)
				{ initial: -58, target: -140 }, // Col 3: UP (-82px drift)
				{ initial: 51,  target: 121 },  // Col 4: DOWN (+70px drift)
			];

			cards.forEach((card, idx) => {
				const col = idx % 4;
				const profile = colProfiles[col];

				gsap.fromTo(
					card,
					{ y: profile.initial },
					{
						y: profile.target,
						ease: 'none',
						scrollTrigger: {
							trigger: grid,
							start: 'top top',
							end: 'bottom bottom',
							scrub: 1.2,
							invalidateOnRefresh: true,
						},
					}
				);
			});
		});

		// 2. Tablet 3-Column Drift
		mm.add('(min-width: 768px) and (max-width: 1279px)', () => {
			const colProfilesTablet = [
				{ initial: -60, target: -150 },
				{ initial: 60,  target: 140 },
				{ initial: -30, target: -90 },
			];

			cards.forEach((card, idx) => {
				const col = idx % 3;
				const profile = colProfilesTablet[col];

				gsap.fromTo(
					card,
					{ y: profile.initial },
					{
						y: profile.target,
						ease: 'none',
						scrollTrigger: {
							trigger: grid,
							start: 'top top',
							end: 'bottom bottom',
							scrub: 1.2,
							invalidateOnRefresh: true,
						},
					}
				);
			});
		});

		// 3. Mobile (< 768px): Natural 1-column stack without drift
		mm.add('(max-width: 767px)', () => {
			cards.forEach((card) => {
				gsap.set(card, { y: 0, clearProps: 'transform' });
			});
		});


		ScrollTrigger.refresh();
	}

	// =========================================================================
	// COMPACT MODAL INTERACTION LOGIC
	// =========================================================================
	function initModalInteractions() {
		const modal = document.getElementById('archiveModal');
		const closeBtn = document.getElementById('modalCloseBtn');
		const typeBadge = document.getElementById('modalTypeBadge');
		const indexBadge = document.getElementById('modalIndexBadge');
		const titleEl = document.getElementById('modalTitle');
		const clientEl = document.getElementById('modalClient');
		const roleEl = document.getElementById('modalRole');
		const yearEl = document.getElementById('modalYear');
		const descEl = document.getElementById('modalDescription');
		const tagsList = document.getElementById('modalTagsList');
		const tagsSection = document.getElementById('modalTagsSection');
		const imgEl = document.getElementById('modalImg') as HTMLImageElement | null;
		const vidEl = document.getElementById('modalVid') as HTMLVideoElement | null;
		const actionsWrap = document.getElementById('modalActionsWrap');
		const liveNoteEl = document.getElementById('modalLiveNote');
		const actionsRow = document.getElementById('modalActionsRow');
		const githubBtn = document.getElementById('modalGithubBtn') as HTMLAnchorElement | null;
		const visitBtn = document.getElementById('modalVisitBtn') as HTMLAnchorElement | null;

		if (!modal) return;

		const openModal = (index: number) => {
			const item = projectsData[index];
			if (!item) return;

			// Set Badges & Typography
			if (typeBadge) {
				typeBadge.textContent = item.type === 'skill' ? '[SOFT SKILL]' : '[PROJECT]';
				typeBadge.className = `modal-type-badge ${item.type === 'skill' ? 'type-skill' : 'type-project'}`;
			}
			if (indexBadge) indexBadge.textContent = item.index;
			if (titleEl) titleEl.textContent = item.title;
			if (clientEl) clientEl.textContent = item.client;
			if (roleEl) {
				if (item.role) {
					roleEl.textContent = `ROLE: ${item.role.toUpperCase()}`;
					roleEl.style.display = 'block';
				} else {
					roleEl.style.display = 'none';
				}
			}
			if (yearEl) yearEl.textContent = item.year;
			if (descEl) descEl.textContent = item.description;

			// Render Tags
			if (tagsList && tagsSection) {
				tagsList.innerHTML = '';
				if (item.tags && item.tags.length > 0) {
					tagsSection.style.display = 'block';
					item.tags.forEach((tag: string) => {
						const pill = document.createElement('span');
						const isFeatured = tag.includes('Finalist') || tag.includes('🏆');
						pill.className = `modal-tag-pill${isFeatured ? ' tag-featured' : ''}`;
						pill.textContent = tag;
						tagsList.appendChild(pill);
					});
				} else {
					tagsSection.style.display = 'none';
				}
			}

			const mediaFrame = document.getElementById('modalMediaFrame');
			if (mediaFrame) {
				mediaFrame.style.aspectRatio = (item as any).modalAspectRatio || '16 / 9';
			}

			// Render Media (Video or Image)
			const displayImg = item.modalImage || item.image;
			if (item.video && vidEl && imgEl) {
				vidEl.src = item.video;
				vidEl.poster = displayImg;
				vidEl.style.display = 'block';
				imgEl.style.display = 'none';
				vidEl.play().catch(() => {});
			} else if (imgEl && vidEl) {
				imgEl.src = displayImg;
				imgEl.alt = `${item.title} Preview`;
				imgEl.style.objectPosition = item.modalImage ? 'center' : ((item as any).objectPosition || 'center');
				imgEl.style.objectFit = (item as any).objectFit || 'cover';
				imgEl.style.display = 'block';
				vidEl.style.display = 'none';
				vidEl.pause();
			}

			// Action Buttons Row & Live Note
			const hasGithub = Boolean(item.github);
			const hasLive = Boolean(item.live);
			const hasNote = Boolean(item.liveNote);

			if (liveNoteEl) {
				if (hasNote) {
					liveNoteEl.textContent = item.liveNote!;
					liveNoteEl.style.display = 'block';
				} else {
					liveNoteEl.style.display = 'none';
				}
			}

			if (actionsWrap && actionsRow) {
				if (!hasGithub && !hasLive && !hasNote) {
					actionsWrap.style.display = 'none';
				} else {
					actionsWrap.style.display = 'flex';
					if (actionsRow) {
						actionsRow.style.display = (!hasGithub && !hasLive) ? 'none' : 'flex';
					}
					if (githubBtn) {
						if (hasGithub) {
							githubBtn.href = item.github!;
							githubBtn.style.display = 'inline-flex';
						} else {
							githubBtn.style.display = 'none';
						}
					}
					if (visitBtn) {
						if (hasLive) {
							visitBtn.href = item.live!;
							visitBtn.style.display = 'inline-flex';
						} else {
							visitBtn.style.display = 'none';
						}
					}
				}
			}

			// Show Modal
			modal.classList.add('active');
			modal.setAttribute('aria-hidden', 'false');

			// Pause Lenis smooth scroll while dialog is open
			if ((window as any).lenis) {
				(window as any).lenis.stop();
			}
			document.body.style.overflow = 'hidden';
		};

		const closeModal = () => {
			if (!modal) return;
			modal.classList.remove('active');
			modal.setAttribute('aria-hidden', 'true');

			// Pause video
			if (vidEl) vidEl.pause();
			if (imgEl) {
				imgEl.style.objectPosition = 'center';
				imgEl.style.objectFit = 'cover';
			}

			const mediaFrame = document.getElementById('modalMediaFrame');
			if (mediaFrame) {
				mediaFrame.style.aspectRatio = '16 / 9';
			}

			// Resume Lenis smooth scroll
			if ((window as any).lenis) {
				(window as any).lenis.start();
			}
			document.body.style.overflow = '';
		};

		// Event delegation on grid: avoids duplicate listeners and gesture blocking
		const gridEl = document.getElementById('podiumGrid');
		gridEl?.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest('[data-project-index]');
			if (!btn) return;
			e.preventDefault();
			const idx = parseInt(btn.getAttribute('data-project-index') || '0', 10);
			openModal(idx);
		});

		closeBtn?.addEventListener('click', closeModal);

		// Backdrop click to close
		modal.addEventListener('click', (e) => {
			if (e.target === modal) closeModal();
		});

		// ESC key listener
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal.classList.contains('active')) {
				closeModal();
			}
		});

		// Auto-open modal if URL specifies a project via query (?project=...) or hash (#...)
		const searchParams = new URLSearchParams(window.location.search);
		const requestedProject = searchParams.get('project') || window.location.hash.replace('#', '');
		if (requestedProject) {
			const projectIdx = projectsData.findIndex((p: { id: string }) => p.id === requestedProject);
			if (projectIdx !== -1) {
				setTimeout(() => openModal(projectIdx), 150);
			}
		}
	}

	function cleanupPage() {
		if (mm) {
			mm.revert();
			mm = null;
		}
		ScrollTrigger.getAll().forEach((st) => st.kill());
	}

	// Clean up triggers on Astro page transitions
	document.addEventListener('astro:before-swap', cleanupPage);

	function initHoverVideoPreviews() {
		const cards = document.querySelectorAll('.project-card');
		cards.forEach((card) => {
			const video = card.querySelector('video.card-video') as HTMLVideoElement | null;
			if (video) {
				card.addEventListener('pointerenter', () => {
					video.play().catch(() => {});
				});
				card.addEventListener('pointerleave', () => {
					video.pause();
				});
			}
		});
	}

	function setupPage() {
		cleanupPage();
		initPodiumScrollDrift();
		initModalInteractions();
		initHoverVideoPreviews();
		requestAnimationFrame(() => {
			ScrollTrigger.refresh();
		});
	}

	if (document.readyState === 'complete' || document.readyState === 'interactive') {
		setupPage();
	} else {
		window.addEventListener('DOMContentLoaded', setupPage);
	}

	document.addEventListener('astro:page-load', setupPage);
</script>

