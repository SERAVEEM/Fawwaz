---
interface Props {
	pageName?: string;
}

const { pageName } = Astro.props;
---

<main class="wip-container" aria-label="Under Development">
	<div class="wip-content">
		{pageName && <span class="wip-label">[{pageName.toUpperCase()}]</span>}
		<p class="wip-message">
			Currently under development. This page will be published following current client deliverables and academic commitments. In the meantime, for collaborations or project inquiries, please reach out via WhatsApp at <a href="https://wa.me/6282133948400" target="_blank" rel="noopener noreferrer" class="wip-link">+62 821 3394 8400</a>.
		</p>
	</div>
</main>

<style>
	.wip-container {
		min-height: calc(100vh - 6rem);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem clamp(1.5rem, 5vw, 4rem);
		background-color: #ffffff;
		box-sizing: border-box;
	}

	.wip-content {
		max-width: 640px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.wip-label {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #999999;
	}

	.wip-message {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		font-size: clamp(1.15rem, 1.8vw, 1.5rem);
		font-weight: 400;
		line-height: 1.6;
		color: #000000;
		letter-spacing: -0.02em;
		margin: 0;
	}

	.wip-link {
		color: #000000;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1.5px;
		transition: opacity 0.2s ease;
	}

	.wip-link:hover {
		opacity: 0.6;
	}
</style>
