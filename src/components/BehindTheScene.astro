---

<section class="telha-all-work-section" id="all-work" aria-label="All Work">
  <!-- Sticky Center Title (Exactly mirrors Telha Clarke's .works-grid-button) -->
  <div class="works-grid-button">
    <a href={`${base}/archive`} class="works-grid-link" aria-label="View All Work">
      <span class="title-text">Archive</span>
      <sup class="title-count">(9)</sup>
    </a>
  </div>

  <!-- Floating Parallax Image Grid -->
  <div class="works-grid-container">
    {
      ROWS.map((row, rowIndex) => (
        <div class="works-grid-row">
          {row.map((item, itemIndex) => (
            <div
              class:list={["works-col", item.colClasses, item.hideMobile ? "hide-on-compact" : ""]}
              style={`--col-desktop: ${item.colDesktop}; --col-mobile: ${item.colMobile || 'auto'};`}
            >
              <div
                class:list={["works-grid-item", item.itemClasses]}
                data-size={item.size}
                data-index={rowIndex * 5 + itemIndex}
                style={`opacity: ${item.opacity ?? 1};`}
              >
                <!-- Scroll Parallax Wrapper -->
                <div
                  class="works-grid-image js-scroll-parallax"
                  data-size={item.size}
                  style={item.aspectRatio ? `aspect-ratio: ${item.aspectRatio} !important;` : undefined}
                >
                  <!-- Interactive Mouse Parallax Inner -->
                  <div
                    class="image-inner js-mouse-parallax"
                    style={getPlaceholder(item.src) ? `background-image: url("${getPlaceholder(item.src)}"); background-size: cover;` : undefined}
                  >
                    <img
                      src="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMSIgaGVpZ2h0PSIxIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxyZWN0IHdpZHRoPSIxIiBoZWlnaHQ9IjEiIGZpbGw9InRyYW5zcGFyZW50Ii8+PC9zdmc+"
                      data-src={r2(item.src.replace(/\.(png|jpg|jpeg)$/i, '.webp'))}
                      alt={item.alt}
                      loading="lazy"
                      decoding="async"
                      class="grid-img"
                      style={[
                        item.objectFit ? `object-fit: ${item.objectFit};` : '',
                        item.objectPosition ? `object-position: ${item.objectPosition};` : ''
                      ].filter(Boolean).join(' ') || undefined}
                    />
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initTelhaWorksGrid() {
    const section = document.getElementById("all-work");
    const button = document.querySelector(".works-grid-button");
    const items = document.querySelectorAll(".works-grid-item");
    const scrollImages = document.querySelectorAll(".js-scroll-parallax");

    if (!section || !button || scrollImages.length === 0) return;

    let isInView = false;
    const mouse = {
      target: { x: 0, y: 0 },
      current: { x: 0, y: 0 }
    };

    // 1. InView Trigger to optimize RAF ticker
    ScrollTrigger.create({
      trigger: section,
      start: "top bottom",
      end: "bottom top",
      onEnter: () => { isInView = true; },
      onEnterBack: () => { isInView = true; },
      onLeave: () => { isInView = false; },
      onLeaveBack: () => { isInView = false; }
    });

    // 2. Sticky Button Scrub Animation (Scales down smoothly on scroll)
    let targetScale = 0.6;
    const windowWidth = window.innerWidth;
    if (windowWidth <= 1024 && windowWidth >= 768) {
      targetScale = 0.7;
    } else if (windowWidth < 768) {
      targetScale = 0.65;
    }

    const buttonTimeline = gsap.timeline();
    buttonTimeline.to(button, { scale: targetScale, ease: "none" });

    ScrollTrigger.create({
      trigger: section,
      start: () => `top-=${0.35 * window.innerHeight}px top`,
      end: () => `top+=${0.1 * window.innerHeight}px top`,
      scrub: 0.4,
      animation: buttonTimeline
    });

    // Fade out button when reaching end of section
    ScrollTrigger.create({
      trigger: section,
      start: "bottom-=35% top",
      end: "bottom-=15% top",
      scrub: 0.4,
      animation: gsap.fromTo(button, { autoAlpha: 1 }, { autoAlpha: 0, ease: "none" })
    });

    // 3. Entrance Fade reveal for first items
    items.forEach((item, index) => {
      if (index < 5) {
        const scrollImg = item.querySelector(".js-scroll-parallax");
        if (scrollImg) {
          gsap.fromTo(
            scrollImg,
            { opacity: 0 },
            {
              opacity: 1,
              ease: "none",
              scrollTrigger: {
                trigger: item,
                start: () => `top-=${gsap.utils.random(10, 45)}% bottom`,
                end: () => `top+=${gsap.utils.random(0, 10)}% top`,
                scrub: 0.4
              }
            }
          );
        }
      }
    });

    // 4. Scroll Parallax Scrubbing (calibrated for organic vertical drift on mobile)
    const isCompact = window.innerWidth < 1024;
    const smallFactor = isCompact ? 0.13 : 0.25;
    const mediumFactor = isCompact ? 0.08 : 0.15;
    const largeFactor = isCompact ? 0.05 : 0.10;
    scrollImages.forEach((img) => {
      const size = img.getAttribute("data-size");
      const parentItem = img.closest(".works-grid-item");
      if (!parentItem) return;

      const factor = size === "large" ? largeFactor : size === "small" ? smallFactor : mediumFactor;
      gsap.fromTo(
        img,
        { y: () => -window.innerHeight * factor },
        {
          y: () => window.innerHeight * factor,
          ease: "none",
          scrollTrigger: {
            trigger: parentItem,
            start: () => `top-=${window.innerHeight * factor}px bottom`,
            end: () => `bottom+=${window.innerHeight * factor}px top`,
            scrub: true
          }
        }
      );
    });

    // 5. Interactive Mouse Parallax (Window-wide Normalized Cursor Tracking on fine pointer devices)
    const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (isFinePointer) {
      activeMouseMove = (e: MouseEvent) => {
        mouse.target.x = gsap.utils.mapRange(0, window.innerWidth, 1, -1, e.clientX);
        mouse.target.y = gsap.utils.mapRange(0, window.innerHeight, 1, -1, e.clientY);
      };

      window.addEventListener("mousemove", activeMouseMove, { passive: true });

      // ponytail: single container CSS variable update instead of 31 inline style DOM mutations
      activeTicker = () => {
        if (!isInView) return;

        const dx = mouse.target.x - mouse.current.x;
        const dy = mouse.target.y - mouse.current.y;
        if (Math.abs(dx) < 0.0005 && Math.abs(dy) < 0.0005) return;

        mouse.current.x += dx * 0.09;
        mouse.current.y += dy * 0.09;

        section.style.setProperty('--mouse-x', mouse.current.x.toFixed(4));
        section.style.setProperty('--mouse-y', mouse.current.y.toFixed(4));
      };

      gsap.ticker.add(activeTicker);
    }
  }

  let activeTicker: (() => void) | null = null;
  let activeMouseMove: ((e: MouseEvent) => void) | null = null;
  let rowObserver: IntersectionObserver | null = null;

  function initProgressiveRowLoading() {
    if (rowObserver) {
      rowObserver.disconnect();
      rowObserver = null;
    }

    rowObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const row = entry.target as HTMLElement;
            observer.unobserve(row);
            const lazyImgs = row.querySelectorAll<HTMLImageElement>('img[data-src]');
            lazyImgs.forEach((img) => {
              const dataSrc = img.getAttribute('data-src');
              if (dataSrc) {
                const preloader = new Image();
                preloader.src = dataSrc;
                preloader.decode().then(() => {
                  img.src = dataSrc;
                  img.removeAttribute('data-src');
                }).catch(() => {
                  img.src = dataSrc;
                  img.removeAttribute('data-src');
                });
              }
            });
          }
        });
      },
      { rootMargin: '600px 0px' }
    );

    document.querySelectorAll('#all-work .works-grid-row').forEach((row) => {
      rowObserver?.observe(row);
    });
  }

  function setupTelhaGrid() {
    if (document.getElementById("all-work")) {
      initTelhaWorksGrid();
      initProgressiveRowLoading();
    }
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTelhaGrid);
  } else {
    setupTelhaGrid();
  }

  document.addEventListener("astro:page-load", setupTelhaGrid);
  document.addEventListener("astro:before-swap", () => {
    if (activeTicker) {
      gsap.ticker.remove(activeTicker);
      activeTicker = null;
    }
    if (activeMouseMove) {
      window.removeEventListener("mousemove", activeMouseMove);
      activeMouseMove = null;
    }
    if (rowObserver) {
      rowObserver.disconnect();
      rowObserver = null;
    }
    ScrollTrigger.getAll().forEach((st) => {
      const triggerEl = st.trigger as HTMLElement | null;
      if (triggerEl && triggerEl.closest("#all-work")) {
        st.kill();
      }
    });
  });
</script>

<style>
  .telha-all-work-section {
    position: relative;
    width: 100%;
    background-color: #fff;
    color: #000;
    margin-top: 0;
    padding-bottom: 20rem;
    overflow: clip;
  }

  @media (min-width: 1200px) {
    .telha-all-work-section {
      margin-top: 0;
      padding-bottom: 28rem;
    }
  }

  /* Sticky Center Headline mirroring Telha Clarke .works-grid-button */
  .works-grid-button {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: -100vh;
    z-index: 20;
    pointer-events: none;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .works-grid-link {
    pointer-events: auto;
    display: inline-flex;
    align-items: baseline;
    gap: clamp(0.25rem, 1vw, 0.75rem);
    text-decoration: none;
    color: #000;
    transition: opacity 0.3s ease;
  }

  .works-grid-link:hover {
    opacity: 0.6;
  }

  .title-text {
    font-size: clamp(3rem, 7.5vw, 6.75rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .title-count {
    font-size: clamp(1.25rem, 2.5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    vertical-align: top;
    line-height: 1;
  }

  /* Grid Layout */
  .works-grid-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-top: 25vh;
    gap: 8rem;
  }

  @media (min-width: 1200px) {
    .works-grid-container {
      padding-top: 35vh;
      gap: 12rem;
    }
  }

  .works-grid-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 2.5vw, 1.5rem);
    row-gap: clamp(1.5rem, 4vw, 3rem);
    padding: 0 clamp(0.75rem, 3.5vw, 3.5rem);
    width: 100%;
    content-visibility: auto;
    contain-intrinsic-size: 0 450px;
  }

  @media (min-width: 1200px) {
    .works-grid-row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2.5rem);
      row-gap: 0;
    }
  }

  .works-col {
    display: flex;
    flex-direction: column;
    grid-column: var(--col-mobile, auto);
  }

  @media (min-width: 1200px) {
    .works-col {
      grid-column: var(--col-desktop, auto);
    }
  }

  .works-col.align-end {
    justify-content: flex-end;
  }

  .works-col.align-center {
    justify-content: center;
  }

  .works-grid-item {
    position: relative;
    width: 100%;
    transition: opacity 0.4s ease;
  }

  /* Spatial offsets mirroring Telha Clarke's organic composition */
  .offset-neg-ml {
    margin-left: -3vw;
  }
  @media (min-width: 1200px) {
    .offset-neg-ml {
      margin-left: -5vw;
    }
  }

  .offset-down-half {
    transform: translateY(18%);
  }
  @media (min-width: 1200px) {
    .offset-down-half {
      transform: translateY(35%);
    }
  }

  .offset-up-half {
    transform: translateY(-18%);
  }
  @media (min-width: 1200px) {
    .offset-up-half {
      transform: translateY(-35%);
    }
  }

  .offset-up-quarter {
    transform: translateY(-10%);
  }
  @media (min-width: 1200px) {
    .offset-up-quarter {
      transform: translateY(-15%);
    }
  }

  .offset-down-quarter {
    transform: translateY(10%);
  }
  @media (min-width: 1200px) {
    .offset-down-quarter {
      transform: translateY(15%);
    }
  }

  .padding-bottom-large {
    padding-bottom: 2.5rem;
  }
  @media (min-width: 1200px) {
    .padding-bottom-large {
      padding-bottom: 5rem;
    }
  }

  @media (max-width: 1023px) {
    .hide-on-compact {
      display: none !important;
    }

    .telha-all-work-section {
      margin-top: 0;
      padding-bottom: 14rem;
    }

    .works-grid-container {
      padding-top: 18vh;
      gap: clamp(5rem, 12vh, 8rem);
    }

    .title-text {
      font-size: clamp(3rem, 10vw, 4.5rem);
    }

    .title-count {
      font-size: clamp(1.25rem, 3.5vw, 1.85rem);
    }
  }

  @media (max-width: 480px) {
    .title-text {
      font-size: clamp(2.65rem, 9vw, 3.5rem);
    }

    .title-count {
      font-size: clamp(1.15rem, 3.5vw, 1.5rem);
    }

    .works-grid-row {
      column-gap: 0.65rem;
      row-gap: 1.25rem;
      padding: 0 0.75rem;
    }
  }

  /* Parallax and Image Containers */
  .works-grid-image {
    position: relative;
    width: 100%;
    overflow: hidden;
    will-change: transform;
  }

  .works-grid-item[data-size="large"] .works-grid-image {
    aspect-ratio: 4 / 5;
  }

  .works-grid-item[data-size="medium"] .works-grid-image {
    aspect-ratio: 3 / 4;
  }

  .works-grid-item[data-size="small"] .works-grid-image {
    aspect-ratio: 1 / 1;
  }

  .image-inner {
    position: relative;
    width: 100%;
    height: 100%;
    will-change: transform;
    transform: translate3d(calc(var(--mouse-x, 0) * var(--mouse-factor, 20px)), calc(var(--mouse-y, 0) * var(--mouse-factor, 20px)), 0);
  }

  .works-grid-item[data-size="large"] .image-inner {
    --mouse-factor: 60px;
  }

  .works-grid-item[data-size="medium"] .image-inner {
    --mouse-factor: 30px;
  }

  .works-grid-item[data-size="small"] .image-inner {
    --mouse-factor: 20px;
  }

  .grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: #f0f0f0;
    transition: filter 0.4s ease;
  }

  .grid-img:hover {
    filter: brightness(0.95);
  }
</style>
