---
// ponytail: 1:1 architectural footer customized for Fawwaz portfolio
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="telha-footer" aria-label="Site Footer">
	<!-- Top Section (White architectural grid) -->
	<div class="footer-top">
		<div class="footer-grid">
			<!-- Col 1: Project CTA & Lets work together -->
			<div class="footer-col col-cta">
				<div class="cta-heading-group">
					<p class="cta-eyebrow">Talk to us about your project</p>
					<a href="#contact" class="cta-link" data-open-contact-modal="true">Contact us</a>
				</div>

				<div class="newsletter-group">
					<span class="newsletter-label">Lets work together.</span>
					<form class="newsletter-form" id="footerNewsletterForm" onsubmit="event.preventDefault();">
						<div class="input-wrapper">
							<input
								type="email"
								name="email"
								placeholder="Enter your email"
								required
								class="newsletter-input"
								aria-label="Email address for inquiry"
							/>
							<button type="submit" class="newsletter-submit" aria-label="Submit inquiry">
								<svg class="submit-arrow" width="13" height="10" viewBox="0 0 13 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M1.19922 0C1.42013 0 1.59961 0.179477 1.59961 0.400391V3.9502C1.59967 4.08821 1.71158 4.2002 1.84961 4.2002H9.60352C9.5349 4.0811 9.45139 3.96801 9.34961 3.86621L6.73047 1.24805C6.555 1.07238 6.55504 0.787026 6.73047 0.611328L7.13867 0.204102C7.31436 0.028412 7.59964 0.0285033 7.77539 0.204102L12.1094 4.53809C12.3632 4.79193 12.3632 5.20417 12.1094 5.45801L7.77539 9.79199C7.59964 9.96759 7.31436 9.96768 7.13867 9.79199L6.73047 9.38477C6.55506 9.20908 6.55504 8.92372 6.73047 8.74805L9.34961 6.12988C9.45019 6.02929 9.53239 5.91733 9.60059 5.7998H0.5C0.223897 5.7998 6.33352e-05 5.57589 0 5.2998V0.400391C0 0.179477 0.179477 0 0.400391 0H1.19922Z" fill="currentColor"/>
								</svg>
							</button>
						</div>
						<span class="newsletter-success" id="newsletterSuccess" aria-live="polite">Thanks for reaching out!</span>
					</form>
				</div>
			</div>

			<!-- Col 2: Navigation & Back to Top (Matching Navbar) -->
			<div class="footer-col col-nav">
				<nav class="nav-links" aria-label="Footer Navigation">
					<a href={`${base}/archive`} class="nav-item">Archive</a>
					<a href={`${base}/#studio`} class="nav-item">Studio</a>
					<a href={`${base}/#process`} class="nav-item">Process</a>
					<a href="#contact" class="nav-item" data-open-contact-modal="true">Let’s Talk</a>
				</nav>

				<div class="back-to-top-wrap">
					<button type="button" class="back-to-top-btn" id="footerBackToTop">
						<span>Back to top</span>
					</button>
				</div>
			</div>

			<!-- Col 3: Details & Socials -->
			<div class="footer-col col-contact">
				<div class="contact-details">
					<div class="detail-row">
						<span class="detail-label">L</span>
						<address class="detail-content">South Jakarta</address>
					</div>
					<div class="detail-row">
						<span class="detail-label">P</span>
						<a href="tel:+6282133948400" class="detail-content link-hover">+62 821 3394 8400</a>
					</div>
					<div class="detail-row">
						<span class="detail-label">C</span>
						<a href="mailto:fawwazsidiqnurseto@gmail.com" class="detail-content link-hover">fawwazsidiqnurseto@gmail.com</a>
					</div>
				</div>

				<div class="social-links-wrap">
					<a href="https://github.com/SERAVEEM" target="_blank" rel="noopener noreferrer" class="social-link">GitHub</a>,{' '}
					<a href="https://www.linkedin.com/in/fawwaz-sidiq-nurseto-b683ab438/" target="_blank" rel="noopener noreferrer" class="social-link">LinkedIn</a>,{' '}
					<a href="https://www.instagram.com/lunatic9015/" target="_blank" rel="noopener noreferrer" class="social-link">Instagram</a>
				</div>
			</div>
		</div>
	</div>
</footer>

<script>
	// Smooth scroll to top
	const bttBtn = document.getElementById('footerBackToTop');
	bttBtn?.addEventListener('click', () => {
		const lenis = (window as any).lenis;
		if (lenis) {
			lenis.scrollTo(0, { duration: 1.2 });
		} else {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		}
	});

	// Inquiry submit interaction
	const form = document.getElementById('footerNewsletterForm') as HTMLFormElement | null;
	const successMsg = document.getElementById('newsletterSuccess');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (successMsg) {
			successMsg.classList.add('visible');
			const input = form.querySelector('input') as HTMLInputElement | null;
			if (input) input.value = '';
			setTimeout(() => {
				successMsg.classList.remove('visible');
			}, 4000);
		}
	});
</script>

<style>
	.telha-footer {
		width: 100%;
		display: flex;
		flex-direction: column;
		background-color: #ffffff;
		color: #111111;
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		margin-top: auto;
		position: relative;
		z-index: 10;
	}

	/* Top Section without random top border */
	.footer-top {
		padding: clamp(3.5rem, 7vw, 7rem) clamp(1.25rem, 4vw, 3.5rem) clamp(3rem, 5vw, 5rem);
		border-top: none;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3.5rem 2rem;
		max-width: 1800px;
		margin: 0 auto;
	}

	@media (min-width: 900px) {
		.footer-grid {
			grid-template-columns: 2fr 1fr 1.3fr;
			gap: 3rem 4rem;
			align-items: stretch;
		}
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	/* Left Col: CTA & Lets work together */
	.cta-heading-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 3.5rem;
	}

	.cta-eyebrow {
		font-size: clamp(1.5rem, 2.5vw, 2.25rem);
		font-weight: 500;
		line-height: 1.15;
		color: #8c8c8c;
		letter-spacing: -0.02em;
		margin: 0;
	}

	.cta-link {
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		color: #000000;
		text-decoration: underline;
		text-underline-offset: 0.22em;
		text-decoration-thickness: 2px;
		letter-spacing: -0.03em;
		display: inline-block;
		width: fit-content;
		transition: opacity 0.2s ease;
	}

	.cta-link:hover {
		opacity: 0.65;
	}

	/* Lets work together form */
	.newsletter-group {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (min-width: 900px) {
		.newsletter-group {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
			gap: 2rem;
		}
	}

	.newsletter-label {
		font-size: 1rem;
		font-weight: 600;
		color: #111111;
		white-space: nowrap;
	}

	.newsletter-form {
		position: relative;
		display: flex;
		align-items: center;
		min-width: min(100%, 280px);
	}

	.input-wrapper {
		display: flex;
		align-items: center;
		width: 100%;
		border-bottom: 1.5px solid #000000;
		padding-bottom: 0.35rem;
	}

	.newsletter-input {
		flex: 1;
		border: none;
		outline: none;
		background: transparent;
		font-family: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		color: #000000;
		padding: 0;
	}

	.newsletter-input::placeholder {
		color: #000000;
		opacity: 0.85;
		font-weight: 600;
	}

	.newsletter-submit {
		background: none;
		border: none;
		padding: 0.25rem 0.5rem;
		min-width: 32px;
		min-height: 32px;
		cursor: pointer;
		color: #000000;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.2s ease;
	}

	.newsletter-submit:hover {
		transform: translateX(3px);
	}

	.newsletter-success {
		position: absolute;
		left: 0;
		bottom: -1.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: #1a7f37;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.newsletter-success.visible {
		opacity: 1;
	}

	/* Col 2: Navigation Links (Matching Navbar) */
	.nav-links {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-bottom: 3.5rem;
	}

	.nav-item {
		font-size: 1.05rem;
		font-weight: 600;
		color: #000000;
		text-decoration: none;
		width: fit-content;
		transition: color 0.2s ease;
	}

	.nav-item:hover {
		color: #8c8c8c;
	}

	.back-to-top-wrap {
		display: flex;
		align-items: flex-end;
	}

	.back-to-top-btn {
		background: none;
		border: none;
		padding: 0.25rem 0;
		min-height: 28px;
		font-family: inherit;
		font-size: 1rem;
		font-weight: 600;
		color: #595959;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.back-to-top-btn:hover {
		color: #000000;
	}

	/* Col 3: Contact & Address Details */
	.contact-details {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: 3.5rem;
	}

	.detail-row {
		display: grid;
		grid-template-columns: 2.2rem 1fr;
		font-size: 1rem;
		line-height: 1.45;
	}

	.detail-label {
		font-weight: 700;
		color: #000000;
	}

	.detail-content {
		font-style: normal;
		font-weight: 600;
		color: #111111;
		margin: 0;
	}

	.link-hover {
		text-decoration: none;
		color: #111111;
		transition: color 0.2s ease;
	}

	.link-hover:hover {
		color: #8c8c8c;
	}

	.social-links-wrap {
		font-size: 1rem;
		font-weight: 600;
		color: #111111;
	}

	.social-link {
		color: #111111;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.social-link:hover {
		color: #8c8c8c;
	}

	/* Bottom Black Section with Sleek Ribbon Proportions */
	.footer-bottom {
		background-color: #000000;
		color: #ffffff;
		padding: clamp(1.25rem, 1.8vw, 1.75rem) clamp(1rem, 2vw, 2rem);
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.5rem;
	}

	.wordmark-container {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		overflow: hidden;
	}

	.natural-wordmark {
		font-size: clamp(1.75rem, 3.2vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1;
		color: #ffffff;
		display: inline-block;
		text-align: center;
		user-select: none;
	}

	/* Legal Row - Centered Clean Copyright */
	.legal-row {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-size: 0.8rem;
		font-weight: 400;
		line-height: 1.3;
		color: rgba(255, 255, 255, 0.45);
	}

	.copyright {
		letter-spacing: 0.01em;
	}
</style>
