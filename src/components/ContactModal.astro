---
// ponytail: Podium 1:1 architectural contact modal with copy-to-clipboard interactions
---

<div
	class="contact-modal-overlay"
	id="contactModalOverlay"
	role="dialog"
	aria-modal="true"
	aria-hidden="true"
	aria-labelledby="contactTitle"
	tabindex="-1"
	data-lenis-prevent
>
	<div class="contact-modal-card" id="contactModalCard" data-lenis-prevent>
		<!-- Header: Massive Headline + Architectural Dashed Close Button -->
		<div class="contact-header-row">
			<h2 class="contact-title" id="contactTitle">
				Available<br />for work
			</h2>

			<button
				type="button"
				class="contact-close-btn"
				id="contactCloseBtn"
				aria-label="Close contact dialog"
			>
				<span class="close-box close-box-label">
					<span class="corner-dot tl"></span>
					<span class="corner-dot tr"></span>
					<span class="corner-dot bl"></span>
					<span class="corner-dot br"></span>
					CLOSE
				</span>
				<span class="close-box close-box-icon">
					<span class="corner-dot tl"></span>
					<span class="corner-dot tr"></span>
					<span class="corner-dot bl"></span>
					<span class="corner-dot br"></span>
					<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
					</svg>
				</span>
			</button>
		</div>

		<!-- Body Grid: Address & Socials (Left/Mid) + Direct Contacts (Right) -->
		<div class="contact-body-grid">
			<!-- Column 1: Studio Address & Socials -->
			<div class="contact-col col-info">
				<div class="info-block">
					<h3 class="info-label">Studio address</h3>
					<p class="info-value">West Jakarta,<br />Indonesia</p>
				</div>

				<div class="social-block">
					<a
						href="https://www.instagram.com/lunatic9015/"
						target="_blank"
						rel="noopener noreferrer"
						class="contact-link"
					>
						Instagram
					</a>
				</div>
			</div>

			<!-- Column 2: Direct Contact Rows (Email, Phone, LinkedIn, GitHub) -->
			<div class="contact-col col-actions">
				<!-- Email Row (Click to Copy + Mailto fallback) -->
				<div class="action-item">
					<span class="action-label">Email</span>
					<div class="action-value-wrap">
						<button
							type="button"
							class="copy-btn js-copy-trigger"
							data-copy="fawwazsidiqnurseto@gmail.com"
							aria-label="Copy email address"
						>
							<span class="copy-text">fawwazsidiqnurseto@gmail.com</span>
							<span class="copy-feedback" aria-hidden="true">Copied!</span>
						</button>
						<a
							href="mailto:fawwazsidiqnurseto@gmail.com"
							class="direct-link"
							title="Send email"
							aria-label="Send email"
						>
							<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</a>
					</div>
				</div>

				<!-- Phone Row (Click to Copy + Tel fallback) -->
				<div class="action-item">
					<span class="action-label">Phone</span>
					<div class="action-value-wrap">
						<button
							type="button"
							class="copy-btn js-copy-trigger"
							data-copy="+6282133948400"
							aria-label="Copy phone number"
						>
							<span class="copy-text">+62 821 3394 8400</span>
							<span class="copy-feedback" aria-hidden="true">Copied!</span>
						</button>
						<a
							href="tel:+6282133948400"
							class="direct-link"
							title="Call phone"
							aria-label="Call phone"
						>
							<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</a>
					</div>
				</div>

				<!-- LinkedIn Row -->
				<div class="action-item">
					<span class="action-label">LinkedIn</span>
					<a
						href="https://www.linkedin.com/in/fawwaz-sidiq-nurseto-b683ab438/"
						target="_blank"
						rel="noopener noreferrer"
						class="action-link"
					>
						<span>fawwaz-sidiq-nurseto</span>
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</a>
				</div>

				<!-- GitHub Row -->
				<div class="action-item">
					<span class="action-label">GitHub</span>
					<a
						href="https://github.com/SERAVEEM"
						target="_blank"
						rel="noopener noreferrer"
						class="action-link"
					>
						<span>github.com/SERAVEEM</span>
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	function initContactModal() {
		const overlay = document.getElementById('contactModalOverlay');
		const card = document.getElementById('contactModalCard');
		const closeBtn = document.getElementById('contactCloseBtn');
		if (!overlay || !card) return;

		const openModal = () => {
			overlay.classList.add('is-open');
			overlay.setAttribute('aria-hidden', 'false');

			// Pause Lenis smooth scrolling while modal is active
			if ((window as any).lenis) {
				(window as any).lenis.stop();
			}
			document.body.style.overflow = 'hidden';
		};

		const closeModal = () => {
			overlay.classList.remove('is-open');
			overlay.setAttribute('aria-hidden', 'true');

			// Resume Lenis smooth scrolling
			if ((window as any).lenis) {
				(window as any).lenis.start();
			}
			document.body.style.overflow = '';
		};

		// Wire all triggers across site
		document.querySelectorAll('[data-open-contact-modal], .contact-pill, a[href^="mailto:fawwaz"]').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				openModal();
			});
		});

		closeBtn?.addEventListener('click', closeModal);

		// Click backdrop to dismiss
		overlay.addEventListener('click', (e) => {
			if (e.target === overlay) {
				closeModal();
			}
		});

		// ESC key listener
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
				closeModal();
			}
		});

		// Copy to clipboard with toast state
		overlay.querySelectorAll('.js-copy-trigger').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const textToCopy = btn.getAttribute('data-copy');
				if (!textToCopy) return;

				try {
					await navigator.clipboard.writeText(textToCopy);
					btn.classList.add('copied');
					setTimeout(() => {
						btn.classList.remove('copied');
					}, 2000);
				} catch {
					// Fallback if clipboard API is blocked
					btn.classList.add('copied');
					setTimeout(() => btn.classList.remove('copied'), 2000);
				}
			});
		});
	}

	if (document.readyState === 'complete' || document.readyState === 'interactive') {
		initContactModal();
	} else {
		window.addEventListener('DOMContentLoaded', initContactModal);
	}

	document.addEventListener('astro:page-load', initContactModal);
	document.addEventListener('astro:before-swap', () => {
		document.body.style.overflow = '';
		if ((window as any).lenis) (window as any).lenis.start();
	});
</script>

<style>
	/* Fullscreen Backdrop */
	.contact-modal-overlay {
		position: fixed;
		inset: 0;
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(12px, 3vw, 24px);
		background-color: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
	}

	.contact-modal-overlay.is-open {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	/* Modal Card matching Podium 1:1 */
	.contact-modal-card {
		position: relative;
		width: 100%;
		max-width: 820px;
		background-color: #ffffff;
		color: #000000;
		padding: clamp(24px, 4.5vw, 44px);
		box-sizing: border-box;
		transform: scale(0.96) translateY(12px);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
	}

	.contact-modal-overlay.is-open .contact-modal-card {
		transform: scale(1) translateY(0);
	}

	/* Header Row */
	.contact-header-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: clamp(36px, 5vw, 56px);
	}

	.contact-title {
		margin: 0;
		font-size: clamp(2.4rem, 6vw, 4.2rem);
		font-weight: 900;
		line-height: 0.88;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		color: #000000;
	}

	/* Architectural Dashed Close Button with Corner Marks */
	.contact-close-btn {
		display: inline-flex;
		align-items: stretch;
		background: transparent;
		border: none;
		padding: 0;
		cursor: pointer;
		color: #000000;
		flex-shrink: 0;
		transition: opacity 0.2s ease;
	}

	.contact-close-btn:hover {
		opacity: 0.7;
	}

	.close-box {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		background: #ffffff;
		border: 1px dashed #000000;
		box-sizing: border-box;
	}

	.close-box-label {
		padding: 0 16px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		border-right: none;
	}

	.close-box-icon {
		width: 44px;
	}

	/* Corner Dots on Dashed Boxes */
	.corner-dot {
		position: absolute;
		width: 3px;
		height: 3px;
		background-color: #000000;
	}
	.corner-dot.tl { top: -1px; left: -1px; }
	.corner-dot.tr { top: -1px; right: -1px; }
	.corner-dot.bl { bottom: -1px; left: -1px; }
	.corner-dot.br { bottom: -1px; right: -1px; }

	/* Body Grid */
	.contact-body-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 36px;
	}

	@media (min-width: 680px) {
		.contact-body-grid {
			grid-template-columns: 1fr 1.25fr;
			gap: 48px;
		}
	}

	/* Left Column */
	.contact-col.col-info {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 32px;
	}

	.info-label {
		margin: 0 0 8px 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: #000000;
		letter-spacing: -0.01em;
	}

	.info-value {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.35;
		color: #2b2b2b;
	}

	.contact-link {
		display: inline-block;
		font-size: 1.15rem;
		font-weight: 700;
		color: #000000;
		text-decoration: none;
		letter-spacing: -0.01em;
		transition: opacity 0.2s ease;
	}

	.contact-link:hover {
		opacity: 0.6;
	}

	/* Right Column: Contact Rows */
	.contact-col.col-actions {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.action-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 3px;
	}

	.action-label {
		font-size: 0.95rem;
		font-weight: 700;
		color: #000000;
		letter-spacing: -0.01em;
	}

	.action-value-wrap {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
	}

	/* Copy Button (Smooth Text / Copied Feedback State) */
	.copy-btn {
		position: relative;
		background: transparent;
		border: none;
		padding: 2px 0;
		margin: 0;
		font-family: inherit;
		font-size: 0.95rem;
		color: #2b2b2b;
		cursor: pointer;
		text-align: left;
		outline: none;
		transition: color 0.2s ease;
	}

	.copy-btn:hover {
		color: #000000;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.copy-feedback {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		background-color: #000000;
		color: #ffffff;
		font-weight: 600;
		font-size: 0.8rem;
		padding: 2px 8px;
		border-radius: 2px;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.copy-btn.copied .copy-feedback {
		opacity: 1;
	}

	.direct-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #777777;
		padding: 4px;
		transition: color 0.2s ease;
	}

	.direct-link:hover {
		color: #000000;
	}

	.action-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.95rem;
		color: #2b2b2b;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.action-link:hover {
		color: #000000;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
